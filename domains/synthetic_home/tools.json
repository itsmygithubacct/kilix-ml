      "back",
      "front",
      "garage"
     ],
     "type": "string"
    },
    "locked": {
     "type": "boolean"
    }
   },
   "required": [
    "door",
    "locked"
   ],
   "type": "object"
  }
 },
 {
  "description": "Open or close the blinds in a room to a percentage",
