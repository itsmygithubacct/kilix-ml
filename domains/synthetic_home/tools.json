  "parameters": {
   "additionalProperties": false,
   "properties": {
    "open_percent": {
     "maximum": 100,
     "minimum": 0,
     "type": "integer"
    },
    "room": {
     "enum": [
      "bedroom",
      "kitchen",
      "living_room",
      "study"
     ],
     "type": "string"
    }
   },
   "required": [
    "room",
    "open_percent"
   ],
   "type": "object"
  }
 },
 {
  "description": "Turn a room's lights on or off and set brightness",
  "name": "set_lights",
  "parameters": {
   "additionalProperties": false,
   "properties": {
    "brightness": {
     "maximum": 100,
     "minimum": 0,
     "type": "integer"
    },
    "on": {
     "type": "boolean"
    },
    "room": {
     "enum": [
      "bedroom",
      "kitchen",
      "living_room",
      "porch",
      "study"
     ],
     "type": "string"
    }
   },
   "required": [
    "room",
    "on"
   ],
   "type": "object"
  }
 },
 {
  "description": "Set the heating target in Celsius and the mode",
